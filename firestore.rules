rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app uses custom session-based authentication (not Firebase Auth).
    // request.auth is always null, so rules cannot be tied to Firebase Auth identity.
    // Access control is enforced at the application layer.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
